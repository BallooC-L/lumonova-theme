{%- assign locale_prefix = "" -%}
{%- unless localization.language.iso_code == "de" -%}
  {%- assign locale_prefix = "/" | append: localization.language.iso_code -%}
{%- endunless -%}
{%- comment -%}
  main-index.liquid
  Homepage — alle Sektionen in Reihenfolge:
  1. Hero, 2. USP-Bar, 3. Categories, 4. TierLadder + TierGrid,
  5. Atmosphere, 6. Featured Products, 7. Compatibility, 8. Trust
{%- endcomment -%}

{%- assign hero_image = section.settings.hero_image -%}
{%- assign hero_cta_primary_url = section.settings.hero_cta_primary_url | default: '/collections/all' -%}

{%- comment -%}
  Ghost-CTA im Hero: zeigt auf das höchste Tier, das tatsächlich Produkte
  hat, und beschriftet sich entsprechend. Über die Section-Einstellung lässt
  sich ein Tier fest vorgeben — hat dieses (noch) keine Produkte, fällt die
  Logik automatisch auf das höchste verfügbare zurück. Der Button wirbt so
  nie für ein leeres Tier, und Label und Ziel können nicht auseinanderlaufen.
{%- endcomment -%}
{%- assign hero_tier_order  = 'tier-smart-plus,tier-smart,tier-classic-plus,tier-classic' | split: ',' -%}
{%- assign hero_tier_labels = 'SMART+,SMART,CLASSIC+,CLASSIC' | split: ',' -%}
{%- assign hero_pinned_tier = section.settings.hero_ghost_tier | default: 'auto' -%}
{%- assign hero_tier_handle = '' -%}
{%- assign hero_tier_name   = '' -%}
{%- for hero_h in hero_tier_order -%}
  {%- if collections[hero_h].all_products_count > 0 -%}
    {%- if hero_pinned_tier == hero_h -%}
      {%- assign hero_tier_handle = hero_h -%}
      {%- assign hero_tier_name   = hero_tier_labels[forloop.index0] -%}
      {%- break -%}
    {%- endif -%}
    {%- if hero_tier_handle == '' -%}
      {%- assign hero_tier_handle = hero_h -%}
      {%- assign hero_tier_name   = hero_tier_labels[forloop.index0] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  ════════════════════════════════════════════════
  1. HERO
  ════════════════════════════════════════════════
{%- endcomment -%}
<section class="hero" aria-label="{{ 'home.hero.aria' | t }}">
  {%- if hero_image != blank -%}
    <img
      src="{{ hero_image | img_url: '2000x' }}"
      srcset="{{ hero_image | img_url: '800x' }} 800w, {{ hero_image | img_url: '1400x' }} 1400w, {{ hero_image | img_url: '2000x' }} 2000w"
      sizes="100vw"
      alt=""
      aria-hidden="true"
      class="hero__bg"
      loading="eager"
      fetchpriority="high"
    >
  {%- endif -%}
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__grid-overlay hero-grid" aria-hidden="true"></div>

  {% render 'logo-arc', variant: 'hero' %}

  <div class="container">
    <div class="hero__content reveal">
      <span class="hero__eyebrow-line" aria-hidden="true"></span>
      <p class="hero__eyebrow">Smart Lighting</p>
      <h1 class="hero__headline">
        <span class="fg-primary">{{ 'home.hero.headline_1' | t }}</span>
        <span class="text-amber">{{ 'home.hero.headline_2' | t }}</span>
        <span class="fg-minimal" style="font-weight:300;">{{ 'home.hero.headline_3' | t }}</span>
      </h1>
      <p class="hero__body">{{ 'home.hero.body' | t }}</p>
      <div class="hero__ctas">
        <a href="{{ hero_cta_primary_url }}" class="btn-amber">{{ 'home.hero.cta_primary_label' | t }}</a>
        {%- if hero_tier_handle != '' -%}
          <a href="{{ locale_prefix }}/collections/{{ hero_tier_handle }}" class="btn-ghost">{{ 'home.hero.cta_ghost_label' | t: tier: hero_tier_name }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  2. USP BAR
  ════════════════════════════════════════════════
{%- endcomment -%}
<section class="usp-bar" aria-label="{{ 'home.usps.aria' | t }}">
  <div class="container">
    <ul class="usp-bar__list" role="list">
      {%- assign usps = 'home.usps.usp_1|home.usps.usp_2|home.usps.usp_3' | split: '|' -%}
      {%- for usp in usps -%}
        <li class="usp-bar__item" role="listitem">
          <span class="usp-bar__text">{{ usp | t }}</span>
          {%- unless forloop.last -%}<span class="usp-bar__divider" aria-hidden="true"></span>{%- endunless -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  3. CATEGORIES
  Verfügbarkeit kommt aus der jeweiligen Collection: hat sie mindestens
  ein storefront-sichtbares Produkt, ist die Karte verlinkt. Drafts sind
  in Liquid gar nicht sichtbar, zählen also korrekterweise nicht mit.
  all_products_count (nicht products_count) — letzteres ist auf
  Collection-Seiten filterabhängig.
  Collections: smart-bulbs, filament, panels, ceiling-lights, tri-proof
  ════════════════════════════════════════════════
{%- endcomment -%}

<section class="section bg-base" aria-labelledby="categories-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="section-eyebrow">{{ 'home.categories.eyebrow' | t }}</p>
      <h2 class="section-title" id="categories-title">{{ 'home.categories.title' | t }}</h2>
      <p class="section-subtitle">{{ 'home.categories.subtitle' | t }}</p>
    </div>
    <div class="grid-5 reveal">
      {%- assign cat_handles = 'smart-bulbs,filament,panels,ceiling-lights,tri-proof' | split: ',' -%}
      {%- assign cat_names   = 'Smart Bulbs,Filament,Panels,Ceiling Lights,Tri-Proof' | split: ',' -%}
      {%- assign cat_icons   = 'lightbulb,emoji_objects,grid_view,wb_iridescent,fluorescent' | split: ',' -%}
      {%- assign cat_descs   = 'smart_bulbs_desc,filament_desc,panels_desc,ceiling_lights_desc,tri_proof_desc' | split: ',' -%}
      {%- assign cat_arias   = 'smart_bulbs_aria,filament_aria,panels_aria,ceiling_lights_aria,tri_proof_aria' | split: ',' -%}

      {%- for cat_handle in cat_handles -%}
        {%- assign i = forloop.index0 -%}
        {%- assign cat_name = cat_names[i] -%}
        {%- assign cat_icon = cat_icons[i] -%}
        {%- assign desc_key = 'home.categories.' | append: cat_descs[i] -%}
        {%- assign aria_key = 'home.categories.' | append: cat_arias[i] -%}
        {%- assign cat_col  = collections[cat_handle] -%}

        {%- if cat_col.all_products_count > 0 -%}
          <a href="{{ locale_prefix }}/collections/{{ cat_handle }}" aria-label="{{ aria_key | t }}">
            <article class="category-card category-card--available">
              <span class="category-card__icon" aria-hidden="true">
                <span class="material-symbols-outlined text-amber" style="font-size:32px;">{{ cat_icon }}</span>
              </span>
              <h3 class="category-card__name">{{ cat_name }}</h3>
              <p class="category-card__desc">{{ desc_key | t }}</p>
              <div class="category-card__status">
                <span class="category-card__available">{{ 'home.categories.available' | t }}</span>
              </div>
            </article>
          </a>
        {%- else -%}
          <article class="category-card category-card--unavailable" aria-disabled="true">
            <span class="category-card__icon" aria-hidden="true" style="opacity:0.3;">
              <span class="material-symbols-outlined text-amber" style="font-size:32px;">{{ cat_icon }}</span>
            </span>
            <h3 class="category-card__name">{{ cat_name }}</h3>
            <p class="category-card__desc">{{ desc_key | t }}</p>
            <div class="category-card__status">
              <span class="soon-pill">{{ 'general.coming_soon' | t }}</span>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  4. TIERS
  Ein Tier ist erst dann verlinkt, wenn mindestens ein aktives Produkt
  in der Tier-Collection liegt (tier-classic, tier-classic-plus,
  tier-smart, tier-smart-plus). Sonst bleibt das „Demnächst"-Pill stehen.
  ════════════════════════════════════════════════
{%- endcomment -%}
<section class="section bg-mid" aria-labelledby="tiers-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="section-eyebrow">{{ 'home.tiers.eyebrow' | t }}</p>
      <h2 class="section-title" id="tiers-title">{{ 'home.tiers.title' | t }}</h2>
      <p class="section-subtitle">{{ 'home.tiers.subtitle' | t }}</p>
    </div>

    <div class="grid-4 reveal">
      {%- assign tier_handles = 'tier-classic,tier-classic-plus,tier-smart,tier-smart-plus' | split: ',' -%}
      {%- assign tier_names  = 'CLASSIC,CLASSIC+,SMART,SMART+' | split: ',' -%}
      {%- assign tier_slugs  = 'classic,classic_plus,smart,smart_plus' | split: ',' -%}
      {%- assign tier_ranges = '€20–€60,€35–€80,€35–€80,€55–€120' | split: ',' -%}
      {%- assign tier_steps  = '01,02,03,04' | split: ',' -%}
      {%- assign feature_keys = 'f1,f2,f3,f4' | split: ',' -%}

      {%- for tier_handle in tier_handles -%}
        {%- assign i = forloop.index0 -%}
        {%- assign tier_col = collections[tier_handle] -%}
        {%- assign tier_available = false -%}
        {%- if tier_col.all_products_count > 0 -%}
          {%- assign tier_available = true -%}
        {%- endif -%}
        {%- if tier_available -%}
          {%- assign check_color = 'var(--color-amber)' -%}
        {%- else -%}
          {%- assign check_color = 'rgba(232,160,96,0.60)' -%}
        {%- endif -%}

        <article class="tier-card{% if tier_handle == 'tier-smart' %} tier-card--recommended{% endif %}">
          <div>
            <p class="tier-card__step">{{ 'home.tiers.step' | t }} {{ tier_steps[i] }}</p>
            <h3 class="tier-card__name">{{ tier_names[i] }}</h3>
            <p class="tier-card__range">{{ tier_ranges[i] }}</p>
            <ul class="tier-card__features" role="list">
              {%- for feature_key in feature_keys -%}
                {%- assign f_key = 'home.tiers.' | append: tier_slugs[i] | append: '.' | append: feature_key -%}
                <li class="tier-card__feature">
                  <span class="material-symbols-outlined" style="font-size:19px; color:{{ check_color }}; flex-shrink:0;" aria-hidden="true">check_circle</span>
                  {{ f_key | t }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
          {%- if tier_available -%}
            <a href="{{ locale_prefix }}/collections/{{ tier_handle }}" class="tier-card__cta">{{ 'home.tiers.learn_more' | t }}</a>
          {%- else -%}
            <div style="margin-top:2.5rem; display:flex; justify-content:center;">
              <span class="soon-pill" style="padding:6px 16px;">{{ 'general.coming_soon' | t }}</span>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  5. ATMOSPHERE
  ════════════════════════════════════════════════
{%- endcomment -%}
<section class="section bg-mid" aria-labelledby="atmosphere-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="section-eyebrow">{{ 'home.atmosphere.eyebrow' | t }}</p>
      <h2 class="section-title" id="atmosphere-title">{{ 'home.atmosphere.title' | t }}</h2>
      <p class="section-subtitle">{{ 'home.atmosphere.subtitle' | t }}</p>
    </div>
    <div class="atmosphere-grid reveal-fade">
      <div class="atmosphere-grid__main">
        <figure class="scene-tile">
          {%- if section.settings.atmosphere_img_1 != blank -%}
            <img src="{{ section.settings.atmosphere_img_1 | img_url: '1400x' }}" alt="{{ 'home.atmosphere.img1_alt' | t }}" class="scene-tile__img" loading="lazy">
          {%- endif -%}
          <figcaption class="scene-tile__caption">{{ 'home.atmosphere.img1_caption' | t }}</figcaption>
        </figure>
      </div>
      <div>
        <figure class="scene-tile">
          {%- if section.settings.atmosphere_img_2 != blank -%}
            <img src="{{ section.settings.atmosphere_img_2 | img_url: '800x' }}" alt="{{ 'home.atmosphere.img2_alt' | t }}" class="scene-tile__img" loading="lazy">
          {%- endif -%}
          <figcaption class="scene-tile__caption">{{ 'home.atmosphere.img2_caption' | t }}</figcaption>
        </figure>
      </div>
      <div>
        <figure class="scene-tile">
          {%- if section.settings.atmosphere_img_3 != blank -%}
            <img src="{{ section.settings.atmosphere_img_3 | img_url: '800x' }}" alt="{{ 'home.atmosphere.img3_alt' | t }}" class="scene-tile__img" loading="lazy">
          {%- endif -%}
          <figcaption class="scene-tile__caption">{{ 'home.atmosphere.img3_caption' | t }}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  6. FEATURED PRODUCTS
  ════════════════════════════════════════════════
{%- endcomment -%}
<section class="section bg-mid" aria-labelledby="featured-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="section-eyebrow">{{ 'home.featured.eyebrow' | t }}</p>
      <h2 class="section-title" id="featured-title">{{ 'home.featured.title' | t }}</h2>
      <p class="section-subtitle">{{ 'home.featured.subtitle' | t }}</p>
    </div>

    {%- assign featured_collection = section.settings.featured_collection -%}
    {%- if featured_collection != blank -%}
      <div class="grid-4 reveal">
        {%- for product in featured_collection.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid-4 reveal">
        {%- for product in collections.all.products limit: 4 -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div style="margin-top:2rem; display:flex; justify-content:flex-end;">
      <a href="{{ locale_prefix }}/collections/all" style="display:inline-flex; align-items:center; gap:4px; font-size:12px; text-transform:uppercase; color:var(--color-amber); letter-spacing:var(--tracking-btn);">
        {{ 'home.featured.all_products' | t }}
        <span class="material-symbols-outlined" style="font-size:17px;" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  7. COMPATIBILITY
  ════════════════════════════════════════════════
{%- endcomment -%}
<section class="section bg-base" aria-labelledby="compat-title">
  <div class="container">
    <div class="section-heading reveal">
      <p class="section-eyebrow">{{ 'home.compat.eyebrow' | t }}</p>
      <h2 class="section-title" id="compat-title">{{ 'home.compat.title' | t }}</h2>
      <p class="section-subtitle">{{ 'home.compat.subtitle' | t }}</p>
    </div>
    {% render 'compatibility-grid' %}
  </div>
</section>

{%- comment -%}
  ════════════════════════════════════════════════
  8. TRUST ROW
  ════════════════════════════════════════════════
{%- endcomment -%}
{% render 'trust-row' %}

{% schema %}
{
  "name": "Homepage",
  "settings": [
    { "type": "paragraph", "content": "Hero-Texte, USPs und Button-Beschriftungen werden über die Sprachdateien / Translate & Adapt gepflegt (home.hero.* und home.usps.*). Hier nur Bild, Button-Ziele und Featured Collection." },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero Hintergrundbild" },
    { "type": "url", "id": "hero_cta_primary_url", "label": "CTA 1 URL" },
    { "type": "select", "id": "hero_ghost_tier", "label": "CTA 2: Ziel-Tier",
      "info": "Automatisch = höchstes Tier mit Produkten. Ein fest gewähltes Tier ohne Produkte fällt automatisch darauf zurück. Die Beschriftung ergibt sich aus dem Ziel.",
      "options": [
        { "value": "auto", "label": "Automatisch" },
        { "value": "tier-smart-plus", "label": "SMART+" },
        { "value": "tier-smart", "label": "SMART" },
        { "value": "tier-classic-plus", "label": "CLASSIC+" },
        { "value": "tier-classic", "label": "CLASSIC" }
      ],
      "default": "auto" },
    { "type": "header", "content": "Atmosphere Bilder" },
    { "type": "image_picker", "id": "atmosphere_img_1", "label": "Atmosphäre Bild 1 (groß)" },
    { "type": "image_picker", "id": "atmosphere_img_2", "label": "Atmosphäre Bild 2" },
    { "type": "image_picker", "id": "atmosphere_img_3", "label": "Atmosphäre Bild 3" },
    { "type": "header", "content": "Featured Products" },
    { "type": "collection", "id": "featured_collection", "label": "Featured Collection" }
  ],
  "presets": [{ "name": "Homepage" }]
}
{% endschema %}

@media (min-width: 768px) { .fb-imgtext { grid-template-columns: 1fr 1fr; min-height: 520px; } .fb-imgtext__text { padding: 3.5rem; } .fb-imgtext--img-right .fb-imgtext__media { order: 2; } }

/* 3 · CCT-Slider */
.fb-cct__head { margin-bottom: 1.75rem; }
.fb-cct__stage { position: relative; border-radius: 1rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); aspect-ratio: 16 / 10; }

.fb-cct__slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%; background: var(--color-amber); border: 2px solid #0a0908; cursor: pointer; box-shadow: 0 0 0 1px rgba(232,160,96,0.5); }
.fb-cct__slider::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: var(--color-amber); border: 2px solid #0a0908; cursor: pointer; }

/* 4 · Szenen-Umschalter */
.fb-scene__head { margin-bottom: 1.5rem; }

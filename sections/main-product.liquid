.fb-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--color-amber); margin-bottom: 1rem; }
.fb-headline { font-size: clamp(30px, 5vw, 52px); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; color: var(--fg-primary); }
.fb-headline--sm { font-size: clamp(26px, 3.5vw, 38px); line-height: 1.1; }

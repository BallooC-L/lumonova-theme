@media (min-width: 768px) { .fb-banner { height: 60vh; min-height: 440px; max-height: 760px; } .fb-banner__img { position: absolute; inset: 0; height: 100%; object-fit: cover; } }
.fb-banner__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,9,8,0.85) 0%, rgba(10,9,8,0.35) 40%, rgba(10,9,8,0) 75%); }

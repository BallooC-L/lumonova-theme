{%- comment -%}
  feature-blocks.liquid
  Modulares, schema-getriebenes Block-System fuer Produktseiten.
  6 Block-Typen, im Theme-Editor frei komponierbar (Reihenfolge frei,
  Bloecke mehrfach nutzbar). Ersetzt die starre Features-Sektion.
  Randlos: Banner, Video (optional), Stat-Band. Im Container: Bild+Text,
  CCT-Slider, Szenen-Umschalter.
{%- endcomment -%}

<section class="feature-blocks" id="feature-blocks-{{ section.id }}" aria-label="{{ 'feature_blocks.section_aria' | t }}">
  {%- for block in section.blocks -%}
    {%- assign seamless = block.settings.seamless -%}
    <div class="fb-block fb-block--{{ block.type }}{% if seamless %} fb-block--seamless{% endif %}" {{ block.shopify_attributes }}>

      {%- case block.type -%}

      {%- comment -%} ── 1 · FULL-WIDTH-BANNER ────────────────────────── {%- endcomment -%}
      {%- when 'banner' -%}
        <div class="fb-banner fb-banner--{{ block.settings.text_position }}">
          {%- if block.settings.image != blank -%}
            <img class="fb-banner__img" src="{{ block.settings.image | image_url: width: 2400 }}"
                 srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1400 }} 1400w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
                 sizes="100vw" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
          {%- else -%}
            <div class="fb-banner__img fb-ph"><span class="material-symbols-outlined" aria-hidden="true">image</span></div>
          {%- endif -%}
          <div class="fb-banner__scrim" aria-hidden="true"></div>
          <div class="fb-banner__content">
            <div class="fb-block__inner container">
              {%- if block.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              {%- if block.settings.headline != blank -%}<h2 class="fb-headline">{{ block.settings.headline }}</h2>{%- endif -%}
              {%- if block.settings.subtext != blank -%}<p class="fb-subtext">{{ block.settings.subtext }}</p>{%- endif -%}
            </div>
          </div>
        </div>

      {%- comment -%} ── 2 · BILD + TEXT ──────────────────────────────── {%- endcomment -%}
      {%- when 'image_text' -%}
        <div class="container">
          <div class="fb-imgtext fb-imgtext--img-{{ block.settings.image_side }}">
            <div class="fb-imgtext__media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
              {%- else -%}
                <div class="fb-ph"><span class="material-symbols-outlined" aria-hidden="true">image</span></div>
              {%- endif -%}
            </div>
            <div class="fb-imgtext__text">
              {%- if block.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              {%- if block.settings.headline != blank -%}<h3 class="fb-headline fb-headline--sm">{{ block.settings.headline }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="fb-richtext">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          </div>
        </div>

      {%- comment -%} ── 3 · CCT-SLIDER ───────────────────────────────── {%- endcomment -%}
      {%- when 'cct_slider' -%}
        <div class="container">
          <div class="fb-cct"
               data-warm="{{ 'feature_blocks.cct.warm' | t }}"
               data-neutral="{{ 'feature_blocks.cct.neutral' | t }}"
               data-daylight="{{ 'feature_blocks.cct.daylight' | t }}">
            <div class="fb-cct__head">
              {%- if block.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
              {%- if block.settings.headline != blank -%}<h3 class="fb-headline fb-headline--sm">{{ block.settings.headline }}</h3>{%- endif -%}
            </div>
            <div class="fb-cct__stage">
              {%- if block.settings.base_image != blank -%}
                <img class="fb-cct__base" src="{{ block.settings.base_image | image_url: width: 1600 }}" alt="{{ block.settings.headline | escape }}" loading="lazy">
              {%- else -%}
                <div class="fb-cct__base fb-ph"><span class="material-symbols-outlined" aria-hidden="true">image</span></div>
              {%- endif -%}
              <div class="fb-cct__veil fb-cct__veil--warm" aria-hidden="true"></div>
              <div class="fb-cct__veil fb-cct__veil--cool" aria-hidden="true"></div>
              <div class="fb-cct__readout" aria-hidden="true">
                <span class="fb-cct__kelvin">4000&thinsp;K</span>
                <span class="fb-cct__label">{{ 'feature_blocks.cct.neutral' | t }}</span>
              </div>
            </div>
            <div class="fb-cct__control">
              <span class="fb-cct__scale">2700&thinsp;K</span>
              <input class="fb-cct__slider" type="range" min="2700" max="6500" step="100" value="4000"
                     aria-label="{{ 'feature_blocks.cct.slider_aria' | t }}">
              <span class="fb-cct__scale">6500&thinsp;K</span>
            </div>
          </div>
        </div>

      {%- comment -%} ── 4 · SZENEN-UMSCHALTER ────────────────────────── {%- endcomment -%}
      {%- when 'scene_switcher' -%}
        <div class="container">
          <div class="fb-scene">
            {%- if block.settings.eyebrow != blank or block.settings.headline != blank -%}
              <div class="fb-scene__head">
                {%- if block.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
                {%- if block.settings.headline != blank -%}<h3 class="fb-headline fb-headline--sm">{{ block.settings.headline }}</h3>{%- endif -%}
              </div>
            {%- endif -%}
            <div class="fb-scene__tabs" role="tablist" aria-label="{{ 'feature_blocks.scene.tablist_aria' | t }}">
              {%- assign shown = 0 -%}
              {%- for i in (1..4) -%}
                {%- assign img_k = 'scene_' | append: i | append: '_image' -%}
                {%- assign lbl_k = 'scene_' | append: i | append: '_label' -%}
                {%- if block.settings[img_k] != blank -%}
                  <button type="button" class="fb-scene__tab{% if shown == 0 %} is-active{% endif %}" role="tab" data-idx="{{ i }}"
                          aria-selected="{% if shown == 0 %}true{% else %}false{% endif %}">
                    {{ block.settings[lbl_k] | default: 'Szene' }}
                  </button>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="fb-scene__stage">
              {%- assign shown = 0 -%}
              {%- for i in (1..4) -%}
                {%- assign img_k = 'scene_' | append: i | append: '_image' -%}
                {%- assign lbl_k = 'scene_' | append: i | append: '_label' -%}
                {%- assign cap_k = 'scene_' | append: i | append: '_caption' -%}
                {%- if block.settings[img_k] != blank -%}
                  <figure class="fb-scene__layer{% if shown == 0 %} is-active{% endif %}" data-idx="{{ i }}" role="tabpanel">
                    <img src="{{ block.settings[img_k] | image_url: width: 1600 }}" alt="{{ block.settings[lbl_k] | escape }}" loading="lazy">
                    {%- if block.settings[cap_k] != blank -%}
                      <figcaption class="fb-scene__caption">{{ block.settings[cap_k] }}</figcaption>
                    {%- endif -%}
                  </figure>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

      {%- comment -%} ── 5 · VIDEO-LOOP ───────────────────────────────── {%- endcomment -%}
      {%- when 'video_loop' -%}
        {%- assign vid_wrap = 'fb-video--full' -%}
        {%- if block.settings.width == 'container' -%}{%- assign vid_wrap = 'fb-video--container' -%}{%- endif -%}
        <div class="fb-video {{ vid_wrap }}">
          {%- if block.settings.width == 'container' -%}<div class="container">{%- endif -%}
          <div class="fb-video__frame">
            {%- if block.settings.video != blank -%}
              <video class="fb-video__el" autoplay muted loop playsinline preload="metadata"
                     {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 1600 }}"{% endif %}>
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {%- elsif block.settings.poster != blank -%}
              <img class="fb-video__el" src="{{ block.settings.poster | image_url: width: 1600 }}" alt="" loading="lazy">
            {%- else -%}
              <div class="fb-video__el fb-ph"><span class="material-symbols-outlined" aria-hidden="true">movie</span></div>
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <p class="fb-video__caption{% unless block.settings.width == 'container' %} container{% endunless %}">{{ block.settings.caption }}</p>
          {%- endif -%}
          {%- if block.settings.width == 'container' -%}</div>{%- endif -%}
        </div>

      {%- comment -%} ── 6 · STAT-ZEILE ───────────────────────────────── {%- endcomment -%}
      {%- when 'stats' -%}
        <div class="fb-stats">
          <div class="container">
            {%- if block.settings.headline != blank -%}
              <p class="fb-stats__head">{{ block.settings.headline }}</p>
            {%- endif -%}
            <div class="fb-stats__row">
              {%- for i in (1..4) -%}
                {%- assign n_k = 'stat_' | append: i | append: '_number' -%}
                {%- assign l_k = 'stat_' | append: i | append: '_label' -%}
                {%- if block.settings[n_k] != blank -%}
                  <div class="fb-stats__item">
                    <span class="fb-stats__num">{{ block.settings[n_k] }}</span>
                    {%- if block.settings[l_k] != blank -%}<span class="fb-stats__label">{{ block.settings[l_k] }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

      {%- endcase -%}
    </div>
  {%- endfor -%}
</section>

{% stylesheet %}
.feature-blocks { padding-bottom: 4rem; }
@media (min-width: 768px) { .feature-blocks { padding-bottom: 7rem; } }

.fb-block { margin-top: 4rem; }
@media (min-width: 768px) { .fb-block { margin-top: 7rem; } }
.fb-block--seamless { margin-top: 0; }

.fb-eyebrow {
  font-size: 12px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.18em; color: var(--color-amber); margin-bottom: 1rem;
}
.fb-headline {
  font-size: clamp(30px, 5vw, 52px); font-weight: 700; line-height: 1.05;
  letter-spacing: -0.02em; color: var(--fg-primary);
}
.fb-headline--sm { font-size: clamp(26px, 3.5vw, 38px); line-height: 1.1; }
.fb-subtext { margin-top: 1.25rem; max-width: 40ch; font-size: 16px; line-height: 1.6; color: rgba(242,242,242,0.72); }
.fb-richtext { margin-top: 1.25rem; font-size: 15px; line-height: 1.7; color: var(--fg-mid); }
.fb-richtext p { margin-bottom: 0.75rem; }

.fb-ph {
  display: flex; align-items: center; justify-content: center;
  background: var(--color-raised); color: rgba(242,242,242,0.12);
  width: 100%; height: 100%;
}
.fb-ph .material-symbols-outlined { font-size: 44px; }

/* 1 · Banner */
.fb-banner { position: relative; width: 100%; overflow: hidden; background: var(--color-deepest); }
.fb-banner__img { display: block; width: 100%; height: auto; }
@media (min-width: 768px) {
  .fb-banner { height: 60vh; min-height: 440px; max-height: 760px; }
  .fb-banner__img { position: absolute; inset: 0; height: 100%; object-fit: cover; }
}
.fb-banner__scrim {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(10,9,8,0.85) 0%, rgba(10,9,8,0.35) 40%, rgba(10,9,8,0) 75%);
}
.fb-banner__content { position: absolute; inset: 0; display: flex; }
.fb-banner__content .fb-block__inner { width: 100%; align-self: flex-end; padding-bottom: 3rem; }
@media (min-width: 768px) { .fb-banner__content .fb-block__inner { padding-bottom: 4rem; } }
.fb-banner--bottom-center { text-align: center; }
.fb-banner--bottom-center .fb-subtext { margin-left: auto; margin-right: auto; }
.fb-banner--bottom-right { text-align: right; }
.fb-banner--bottom-right .fb-subtext { margin-left: auto; }

/* 2 · Bild + Text */
.fb-imgtext {
  display: grid; grid-template-columns: 1fr; background: var(--color-raised);
  border-radius: 1rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);
}
.fb-imgtext__media { position: relative; min-height: 300px; }
.fb-imgtext__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.fb-imgtext__media .fb-ph { position: absolute; inset: 0; }
.fb-imgtext__text { padding: 2.5rem 1.75rem; display: flex; flex-direction: column; justify-content: center; }
@media (min-width: 768px) {
  .fb-imgtext { grid-template-columns: 1fr 1fr; min-height: 520px; }
  .fb-imgtext__text { padding: 3.5rem; }
  .fb-imgtext--img-right .fb-imgtext__media { order: 2; }
}

/* 3 · CCT-Slider */
.fb-cct__head { margin-bottom: 1.75rem; }
.fb-cct__stage {
  position: relative; border-radius: 1rem; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08); aspect-ratio: 16 / 10;
}
.fb-cct__base { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.fb-cct__veil { position: absolute; inset: 0; mix-blend-mode: overlay; opacity: 0; transition: opacity 0.12s linear; pointer-events: none; }
.fb-cct__veil--warm { background: radial-gradient(120% 120% at 50% 45%, rgba(255,168,74,0.95), rgba(255,140,48,0.45) 55%, rgba(255,120,30,0) 100%); }
.fb-cct__veil--cool { background: radial-gradient(120% 120% at 50% 45%, rgba(186,214,255,0.9), rgba(150,190,255,0.4) 55%, rgba(120,170,255,0) 100%); }
.fb-cct__readout {
  position: absolute; left: 1rem; bottom: 1rem; display: flex; flex-direction: column; gap: 2px;
  padding: 0.6rem 0.9rem; border-radius: 0.6rem; background: rgba(10,9,8,0.55);
  backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.08);
}
.fb-cct__kelvin { font-size: 20px; font-weight: 700; color: var(--color-amber); letter-spacing: 0.02em; }
.fb-cct__label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(242,242,242,0.7); }
.fb-cct__control { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; }
.fb-cct__scale { font-size: 11px; color: var(--fg-minimal); white-space: nowrap; }
.fb-cct__slider {
  -webkit-appearance: none; appearance: none; flex: 1; height: 3px; border-radius: 3px;
  background: linear-gradient(to right, rgba(255,168,74,0.7), rgba(242,242,242,0.5), rgba(186,214,255,0.7));
  outline: none;
}
.fb-cct__slider::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%;
  background: var(--color-amber); border: 2px solid #0a0908; cursor: pointer; box-shadow: 0 0 0 1px rgba(232,160,96,0.5);
}
.fb-cct__slider::-moz-range-thumb {
  width: 20px; height: 20px; border-radius: 50%; background: var(--color-amber);
  border: 2px solid #0a0908; cursor: pointer;
}

/* 4 · Szenen-Umschalter */
.fb-scene__head { margin-bottom: 1.5rem; }
.fb-scene__tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
.fb-scene__tab {
  font-size: 13px; font-weight: 600; letter-spacing: 0.02em; padding: 0.5rem 1.1rem;
  border-radius: 999px; border: 1px solid rgba(255,255,255,0.12); background: transparent;
  color: rgba(242,242,242,0.6); cursor: pointer; transition: color 0.2s, border-color 0.2s, background 0.2s;
}
.fb-scene__tab:hover { color: var(--fg-high); }
.fb-scene__tab.is-active { color: #0a0908; background: var(--color-amber); border-color: var(--color-amber); }
.fb-scene__stage {
  position: relative; border-radius: 1rem; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08); aspect-ratio: 16 / 9; min-height: 280px;
}
.fb-scene__layer { position: absolute; inset: 0; opacity: 0; transition: opacity 0.45s ease; }
.fb-scene__layer.is-active { opacity: 1; }
.fb-scene__layer img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.fb-scene__caption {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 0.75rem 1rem; font-size: 12px;
  color: rgba(242,242,242,0.85); letter-spacing: 0.04em;
  background: linear-gradient(to top, rgba(10,9,8,0.85), rgba(10,9,8,0));
}

/* 5 · Video-Loop */
.fb-video__frame { position: relative; width: 100%; background: var(--color-deepest); overflow: hidden; }
.fb-video--container .fb-video__frame { border-radius: 1rem; border: 1px solid rgba(255,255,255,0.08); }
.fb-video__el { display: block; width: 100%; height: auto; }
.fb-video__caption { margin-top: 0.9rem; font-size: 12px; color: var(--fg-mid); letter-spacing: 0.04em; }

/* 6 · Stat-Zeile */
.fb-stats { background: var(--color-deepest); padding: 3rem 0; }
.fb-stats__head { text-align: center; font-size: 13px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--fg-minimal); margin-bottom: 1.75rem; }
.fb-stats__row { display: flex; flex-wrap: wrap; justify-content: center; }
.fb-stats__item {
  flex: 1 1 40%; min-width: 140px; text-align: center; padding: 0.75rem 1rem;
  display: flex; flex-direction: column; gap: 0.35rem;
}
.fb-stats__item + .fb-stats__item { border-left: 1px solid rgba(255,255,255,0.08); }
.fb-stats__num { font-size: clamp(28px, 4vw, 38px); font-weight: 700; color: var(--color-amber); line-height: 1; letter-spacing: -0.01em; }
.fb-stats__label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(242,242,242,0.55); }
@media (min-width: 768px) { .fb-stats__item { flex: 1 1 0; } }
{% endstylesheet %}

{% javascript %}
(function () {
  function initCCT(root) {
    if (root.dataset.fbInit) return; root.dataset.fbInit = '1';
    var slider = root.querySelector('.fb-cct__slider');
    var warm = root.querySelector('.fb-cct__veil--warm');
    var cool = root.querySelector('.fb-cct__veil--cool');
    var kEl = root.querySelector('.fb-cct__kelvin');
    var lEl = root.querySelector('.fb-cct__label');
    if (!slider) return;
    var lblWarm = root.dataset.warm || 'Warm';
    var lblNeutral = root.dataset.neutral || 'Neutral';
    var lblDaylight = root.dataset.daylight || 'Daylight';
    function apply() {
      var v = parseInt(slider.value, 10);
      var t = (v - 2700) / 3800; // 0..1
      var wOp = Math.max(0, (0.5 - t) * 2) * 0.9;
      var cOp = Math.max(0, (t - 0.5) * 2) * 0.8;
      if (warm) warm.style.opacity = wOp.toFixed(3);
      if (cool) cool.style.opacity = cOp.toFixed(3);
      if (kEl) kEl.innerHTML = v.toLocaleString('de-DE') + ' K';
      if (lEl) lEl.textContent = v <= 3600 ? lblWarm : (v <= 5200 ? lblNeutral : lblDaylight);
    }
    slider.addEventListener('input', apply);
    apply();
  }

  function initScene(root) {
    if (root.dataset.fbInit) return; root.dataset.fbInit = '1';
    var tabs = root.querySelectorAll('.fb-scene__tab');
    var layers = root.querySelectorAll('.fb-scene__layer');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var idx = tab.dataset.idx;
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        layers.forEach(function (l) { l.classList.toggle('is-active', l.dataset.idx === idx); });
      });
    });
  }

  function initAll(scope) {
    (scope || document).querySelectorAll('.fb-cct').forEach(initCCT);
    (scope || document).querySelectorAll('.fb-scene').forEach(initScene);
  }

  if (document.readyState !== 'loading') { initAll(); }
  else { document.addEventListener('DOMContentLoaded', function () { initAll(); }); }
  document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Feature-Blöcke",
  "tag": "section",
  "class": "feature-blocks-section",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Full-Width-Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (randlos)" },
        { "type": "text", "id": "image_alt", "label": "Alt-Text (Barrierefreiheit)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "headline", "label": "Headline" },
        { "type": "textarea", "id": "subtext", "label": "Subtext (optional)" },
        { "type": "select", "id": "text_position", "label": "Text-Position", "default": "bottom-left",
          "options": [
            { "value": "bottom-left", "label": "Unten links" },
            { "value": "bottom-center", "label": "Unten mitte" },
            { "value": "bottom-right", "label": "Unten rechts" }
          ] },
        { "type": "checkbox", "id": "seamless", "label": "Nahtlos an vorherigen Block anschließen", "default": false }
      ]
    },
    {
      "type": "image_text",
      "name": "Bild + Text",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_alt", "label": "Alt-Text (Barrierefreiheit)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "headline", "label": "Headline" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "select", "id": "image_side", "label": "Bild-Seite", "default": "left",
          "options": [ { "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" } ] },
        { "type": "checkbox", "id": "seamless", "label": "Nahtlos an vorherigen Block anschließen", "default": false }
      ]
    },
    {
      "type": "cct_slider",
      "name": "CCT-Slider",
      "settings": [
        { "type": "image_picker", "id": "base_image", "label": "Basisbild" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },

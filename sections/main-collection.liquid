{%- comment -%}
  main-collection.liquid
  Kollektionsseite mit Kategorie- und Tier-Filter-Chips + Sortierung

  URL-Modell (kanonisch)
  ──────────────────────
  Kategorie und Tier sind zwei unabhängige Achsen, jede mit eigener Collection:
    Kategorie: /collections/{smart-bulbs | filament | panels | ceiling-lights}
    Tier:      /collections/{tier-classic | tier-classic-plus | tier-smart | tier-smart-plus}
  Die Collection, in der man sich befindet, ist die primäre Achse. Die zweite
  Achse wird als natives Tag-Filter darauf gelegt, z. B.
  /collections/panels/tier-classic. Die kanonische URL ist immer die Collection
  ohne Tag — das erledigt Shopifys canonical_url in theme.liquid automatisch.

  Verfügbarkeit eines Chips = die zugehörige Collection hat mindestens ein
  storefront-sichtbares Produkt (all_products_count, nicht products_count —
  letzteres ist filterabhängig). Bewusst global geprüft, nicht als Schnittmenge
  mit der aktiven Achse: ein Chip kann also zu einem leeren Ergebnis führen,
  dafür gibt es den Empty State.
{%- endcomment -%}
{%- assign locale_prefix = "" -%}
{%- unless localization.language.iso_code == "de" -%}
  {%- assign locale_prefix = "/" | append: localization.language.iso_code -%}
{%- endunless -%}

{%- assign cat_handles  = 'smart-bulbs,filament,panels,ceiling-lights' | split: ',' -%}
{%- assign cat_names    = 'Smart Bulbs,Filament,Panels,Ceiling Lights' | split: ',' -%}
{%- assign cat_icons    = 'lightbulb,emoji_objects,grid_on,light_mode' | split: ',' -%}
{%- assign tier_handles = 'tier-classic,tier-classic-plus,tier-smart,tier-smart-plus' | split: ',' -%}
{%- assign tier_names   = 'CLASSIC,CLASSIC+,SMART,SMART+' | split: ',' -%}

{%- comment -%} Welche Achse ist primär, und welcher Tag liegt als zweite darauf? {%- endcomment -%}
{%- assign cat_list    = '|smart-bulbs|filament|panels|ceiling-lights|' -%}
{%- assign tier_list   = '|tier-classic|tier-classic-plus|tier-smart|tier-smart-plus|' -%}
{%- assign current_key = '|' | append: collection.handle | append: '|' -%}
{%- assign axis = 'none' -%}
{%- if cat_list contains current_key -%}
  {%- assign axis = 'category' -%}
{%- elsif tier_list contains current_key -%}
  {%- assign axis = 'tier' -%}
{%- endif -%}
{%- comment -%}
  carry = der Tag der zweiten Achse. Bewusst auf einen Leerstring
  normalisiert, damit die Vergleiche unten nicht von nil/blank-Semantik
  abhängen.
{%- endcomment -%}
{%- assign carry = '' -%}
{%- if current_tags.size > 0 -%}
  {%- assign carry = current_tags | first -%}
{%- endif -%}

{%- comment -%} Aktive Werte je Achse — unabhängig davon, welche primär ist {%- endcomment -%}
{%- assign active_cat  = '' -%}
{%- assign active_tier = '' -%}
{%- if axis == 'category' -%}
  {%- assign active_cat  = collection.handle -%}
  {%- assign active_tier = carry -%}
{%- elsif axis == 'tier' -%}
  {%- assign active_tier = collection.handle -%}
  {%- assign active_cat  = carry -%}
{%- endif -%}

{%- assign col_base = locale_prefix | append: '/collections/' -%}
{%- assign current_path = col_base | append: collection.handle -%}
{%- if carry != '' -%}
  {%- assign current_path = current_path | append: '/' | append: carry -%}
{%- endif -%}

{%- comment -%} "Alle"-Chips setzen ihre eigene Achse zurück und behalten die andere {%- endcomment -%}
{%- if active_tier != '' -%}
  {%- assign all_cats_url = col_base | append: active_tier -%}
{%- else -%}
  {%- assign all_cats_url = col_base | append: 'all' -%}
{%- endif -%}
{%- if active_cat != '' -%}
  {%- assign all_tiers_url = col_base | append: active_cat -%}
{%- else -%}
  {%- assign all_tiers_url = col_base | append: 'all' -%}
{%- endif -%}

<section class="section bg-base" aria-labelledby="collection-title">
  <div class="container">

    {%- comment -%} Heading {%- endcomment -%}
    <div class="section-heading">
      <p class="section-eyebrow">{{ 'collection.eyebrow' | t }}</p>
      <h1 class="section-title" id="collection-title">
        {%- if collection.title != blank -%}
          {{ collection.title }}
        {%- else -%}
          {{ 'collection.all_products_title' | t }}
        {%- endif -%}
      </h1>
      <p class="section-subtitle">{{ 'collection.subtitle' | t }}</p>
      <div style="width:2rem; height:2px; background:var(--color-amber); margin-top:1rem;"></div>
    </div>

    {%- comment -%} Filter-Chips {%- endcomment -%}
    <div style="margin-top:2.5rem; display:flex; flex-direction:column; gap:1rem;">

      {%- comment -%} Achse 1: Kategorie {%- endcomment -%}
      <div>
        <p class="filter-row__label">{{ 'collection.filter_category' | t }}</p>
        <div class="filter-row__chips no-scrollbar">
          <a href="{{ all_cats_url }}" class="filter-chip{% if active_cat == '' %} is-active{% endif %}">
            <span class="material-symbols-outlined" style="font-size:17px;" aria-hidden="true">grid_view</span>
            {{ 'collection.filter_all' | t }}
          </a>

          {%- for cat_handle in cat_handles -%}
            {%- assign cat_name = cat_names[forloop.index0] -%}
            {%- assign cat_icon = cat_icons[forloop.index0] -%}
            {%- if active_tier == '' -%}
              {%- assign cat_url = col_base | append: cat_handle -%}
            {%- elsif axis == 'tier' -%}
              {%- assign cat_url = col_base | append: active_tier | append: '/' | append: cat_handle -%}
            {%- else -%}
              {%- assign cat_url = col_base | append: cat_handle | append: '/' | append: active_tier -%}
            {%- endif -%}

            {%- if collections[cat_handle].all_products_count > 0 -%}
              <a href="{{ cat_url }}" class="filter-chip{% if active_cat == cat_handle %} is-active{% endif %}">
                <span class="material-symbols-outlined" style="font-size:17px;" aria-hidden="true">{{ cat_icon }}</span>
                {{ cat_name }}
              </a>
            {%- else -%}
              <span class="filter-chip filter-chip--disabled" aria-disabled="true">
                <span class="material-symbols-outlined" style="font-size:17px;" aria-hidden="true">{{ cat_icon }}</span>
                {{ cat_name }} <span class="soon-pill">{{ 'general.coming_soon' | t }}</span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Achse 2: Tier {%- endcomment -%}
      <div>
        <p class="filter-row__label">{{ 'collection.filter_tier' | t }}</p>
        <div class="filter-row__chips no-scrollbar">
          <a href="{{ all_tiers_url }}" class="filter-chip{% if active_tier == '' %} is-active{% endif %}">{{ 'collection.filter_all_tiers' | t }}</a>

          {%- for tier_handle in tier_handles -%}
            {%- if active_cat == '' -%}
              {%- assign tier_url = col_base | append: tier_handle -%}
            {%- elsif axis == 'category' -%}
              {%- assign tier_url = col_base | append: active_cat | append: '/' | append: tier_handle -%}
            {%- else -%}
              {%- assign tier_url = col_base | append: tier_handle | append: '/' | append: active_cat -%}
            {%- endif -%}

            {%- if collections[tier_handle].all_products_count > 0 -%}
              <a href="{{ tier_url }}" class="filter-chip{% if active_tier == tier_handle %} is-active{% endif %}">{{ tier_names[forloop.index0] }}</a>
            {%- else -%}
              <span class="filter-chip filter-chip--disabled" aria-disabled="true">{{ tier_names[forloop.index0] }} <span class="soon-pill">{{ 'general.coming_soon' | t }}</span></span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} Toolbar: count + sort {%- endcomment -%}
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; margin-top:1.5rem; margin-bottom:2rem;">
      <p style="font-size:13px; font-weight:500; color:var(--fg-mid);" aria-live="polite">
        {{ collection.products_count }}
        {%- if collection.products_count == 1 -%} {{ 'collection.product_singular' | t }}{%- else -%} {{ 'collection.product_plural' | t }}{%- endif -%}
      </p>

      <label style="display:flex; align-items:center; gap:0.5rem; font-size:13px; color:var(--fg-mid);">
        <span>{{ 'collection.sort_label' | t }}:</span>
        <select
          class="sort-select"
          onchange="location.href = this.value"
          aria-label="{{ 'collection.sort_label' | t }}"
        >
          <option value="{{ current_path }}?sort_by=manual"
            {% if collection.sort_by == 'manual' or collection.sort_by == '' %}selected{% endif %}>
            {{ 'collection.sort_recommended' | t }}
          </option>
          <option value="{{ current_path }}?sort_by=price-ascending"
            {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>
            {{ 'collection.sort_price_asc' | t }}
          </option>
          <option value="{{ current_path }}?sort_by=price-descending"
            {% if collection.sort_by == 'price-descending' %}selected{% endif %}>
            {{ 'collection.sort_price_desc' | t }}
          </option>
          <option value="{{ current_path }}?sort_by=title-ascending"
            {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>
            {{ 'collection.sort_name_az' | t }}
          </option>
        </select>
      </label>
    </div>

    {%- comment -%}
      Product grid — paginate war vorher nie geöffnet, dadurch war das Grid
      still auf 50 Produkte gedeckelt und der Pagination-Block toter Code.
    {%- endcomment -%}
    {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid-3" role="list">
        {%- for product in collection.products -%}
          <div role="listitem">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Pagination {%- endcomment -%}
      {%- if paginate.pages > 1 -%}
        <div style="display:flex; justify-content:center; gap:0.5rem; margin-top:3rem;" aria-label="{{ 'collection.pagination_aria' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn-ghost" style="padding:0.5rem 1rem;">{{ 'collection.pagination_prev' | t }}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="filter-chip">{{ part.title }}</a>
            {%- else -%}
              <span class="filter-chip is-active">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn-ghost" style="padding:0.5rem 1rem;">{{ 'collection.pagination_next' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Empty state {%- endcomment -%}
      <div class="empty-state" role="status">
        <p class="empty-state__icon material-symbols-outlined" aria-hidden="true">search_off</p>
        <p class="empty-state__title">{{ 'collection.empty_title' | t }}</p>
        <p class="empty-state__body">{{ 'collection.empty_body' | t }}</p>
        <a href="{{ col_base }}all" class="btn-ghost">{{ 'collection.reset_filter' | t }}</a>
      </div>
    {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>

{% schema %}
{
  "name": "Kollektion",
  "settings": []
}
{% endschema %}
